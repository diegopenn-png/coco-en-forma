{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coco-eterna-v159",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.cocoenforma.com,https://cocoenforma.com",
    "PUBLIC_SITE_URL": "https://www.cocoenforma.com",
    "AI_PROVIDER": "cloudflare",
    "ENABLE_OPENAI_FALLBACK": "true",
    "OPENAI_FALLBACK_MODEL": "gpt-5.6-luna",
    "SCOPE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "SCOPE_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "SCOPE_REASONING_EFFORT": "low",
    "TUTOR_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "TUTOR_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "TUTOR_COMPATIBILITY_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "TUTOR_REASONING_EFFORT": "high",
    "VERIFIER_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "VERIFIER_REASONING_EFFORT": "high",
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "VISION_REASONING_EFFORT": "high",
    "ENABLE_ACADEMIC_WEB_SEARCH": "false",
    "ENABLE_OFFICIAL_WEB_SEARCH": "false",
    "WEB_SEARCH_MODEL": "gpt-5.6-terra",
    "WEB_SEARCH_REASONING_EFFORT": "low",
    "MODERATION_MODEL": "@cf/meta/llama-guard-3-8b",
    "TRANSCRIBE_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "TTS_MODEL": "@cf/myshell-ai/melotts",
    "MAX_CHAT_REQUESTS_PER_DAY": "60"
  }
}
