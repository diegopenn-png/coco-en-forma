    function words(v){return new Set(normalizeForSearch(v).split(/\s+/).filter(x=>x.length>2&&!/^(recuerdas|acuerdas|hablamos|vimos|estudiamos|seguir|seguimos|retomar|retomamos|tema|sobre|esto|eso)$/.test(x)))}
    function matchMemory(c,t){if(!recallReq(t))return null;const q=words(t);let b=null,n=0;for(const m of c.academicMemory||[]){const w=words([m.topic_label,m.resolved_meaning,m.subject,(m.key_points||[]).join(" ")].filter(Boolean).join(" "));let k=0;q.forEach(x=>{if(w.has(x)||normalizeForSearch(m.topic_label||"").includes(x))k+=3});if(k>n){n=k;b=m}}return n?b:null}
    function recallReply(m){const a=m.resolved_meaning?` como ${m.resolved_meaning}`:"",z=String(m.summary_text||"").trim();return`Sí. Estuvimos trabajando ${m.topic_label}${a}.${z?" "+z:""}`.slice(0,1500)}
    async function bumpRecall(e,u,m){try{const last=m?.last_seen_at?new Date(m.last_seen_at).getTime():0;if(last&&Date.now()-last<8000)return;await supabase(e,`eterna_academic_memory?user_id=eq.${encodeURIComponent(u)}&memory_key=eq.${encodeURIComponent(m.memory_key)}`,{method:"PATCH",body:{recall_count:Number(m.recall_count||0)+1,last_seen_at:new Date().toISOString(),updated_at:new Date().toISOString()}})}catch(_){}}
    function ambiguityOptionWithA(v){const x=cleanChildText(v||"").trim();if(/^el\s+/i.test(x))return"al "+x.replace(/^el\s+/i,"");return"a "+x}
