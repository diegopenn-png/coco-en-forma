    function createChatTimings(){const started=Date.now();let previous=started;const stages=[];return{mark(name){const now=Date.now(),duration=Math.max(0,now-previous);previous=now;stages.push({name:String(name||"stage").replace(/[^a-z0-9_-]/gi,"_").slice(0,32),duration});return duration},headers(){const total=Math.max(0,Date.now()-started),parts=stages.map(stage=>`eterna_${stage.name};dur=${stage.duration}`);parts.push(`eterna_total;dur=${total}`);return{"Server-Timing":parts.join(", "),"X-Eterna-Latency-Ms":String(total)}}}}
