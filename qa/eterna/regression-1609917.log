    function supabasePublicKey(env){return env.SUPABASE_PUBLISHABLE_KEY||env.SUPABASE_ANON_KEY||""}
    function supabaseSecretKey(env){return env.SUPABASE_SECRET_KEY||env.SUPABASE_SERVICE_ROLE_KEY||""}
    async function authenticate(request,env){const publicKey=supabasePublicKey(env);if(!env.SUPABASE_URL||!publicKey)throw new Error("Missing environment variable: SUPABASE_URL or SUPABASE_PUBLISHABLE_KEY");const auth=request.headers.get("Authorization")||"";if(!auth.startsWith("Bearer "))return null;const token=auth.slice(7);const r=await fetch(env.SUPABASE_URL.replace(/\/$/,"")+"/auth/v1/user",{headers:{apikey:publicKey,Authorization:"Bearer "+token}});if(!r.ok)return null;const user=await r.json();return{user,token}}
    async function supabase(env,path,{method="GET",body,service=true,headers={}}={}){const key=service?supabaseSecretKey(env):supabasePublicKey(env);if(!env.SUPABASE_URL||!key)throw new Error("Missing environment variable: SUPABASE_URL or Supabase API key");const baseHeaders={apikey:key,"Content-Type":"application/json",Prefer:"return=representation",...headers};if(!key.startsWith("sb_secret_")&&!key.startsWith("sb_publishable_"))baseHeaders.Authorization="Bearer "+key;const r=await fetch(env.SUPABASE_URL.replace(/\/$/,"")+"/rest/v1/"+path,{method,headers:baseHeaders,body:body==null?undefined:JSON.stringify(body)});if(!r.ok){const t=await r.text();throw new Error("Supabase "+r.status+": "+t.slice(0,400))}const txt=await r.text();return txt?JSON.parse(txt):null}
    async function safeSupabaseRead(env,path){try{return await supabase(env,path)}catch(e){return[]}}
    async function getStudentContext(env,uid){const [profiles,bases,mastery,memory,strategies,signals,academicMemory]=await Promise.all([
      safeSupabaseRead(env,`eterna_student_profiles?user_id=eq.${encodeURIComponent(uid)}&select=*`),
      safeSupabaseRead(env,`perfiles?id=eq.${encodeURIComponent(uid)}&select=apodo,edad,rol`),
      safeSupabaseRead(env,`eterna_mastery?user_id=eq.${encodeURIComponent(uid)}&select=mastery_score,last_help_level,avg_help_level,attempts,concept_id,last_practiced_at,eterna_concepts(title,subject,school_year)&order=mastery_score.asc,last_practiced_at.asc.nullsfirst&limit=18`),
      safeSupabaseRead(env,`eterna_student_concept_memory?user_id=eq.${encodeURIComponent(uid)}&select=subject,concept_label,concept_key,mastery_score,last_help_level,avg_help_level,attempts,independent_successes,assisted_successes,errors,partials,last_practiced_at&order=mastery_score.asc,last_practiced_at.asc.nullsfirst&limit=24`),
      safeSupabaseRead(env,`eterna_learning_strategy_memory?user_id=eq.${encodeURIComponent(uid)}&select=subject,strategy_key,evidence_count,positive_evidence,negative_evidence,success_score,last_observed_at&order=success_score.desc&limit=40`),
      safeSupabaseRead(env,`eterna_learning_signals?user_id=eq.${encodeURIComponent(uid)}&select=concept_id,signal_type,numeric_value,evidence_count,last_observed_at&order=last_observed_at.desc&limit=40`),
      safeSupabaseRead(env,`eterna_academic_memory?user_id=eq.${encodeURIComponent(uid)}&select=memory_key,subject,topic_label,resolved_meaning,summary_text,key_points,next_step,strategy_key,last_help_level,last_seen_at,next_review_at,review_interval_days,retention_score,recall_count&order=last_seen_at.desc&limit=40`)
    ]);return{profile:profiles?.[0]||null,base:bases?.[0]||null,mastery:mastery||[],memory:memory||[],strategyMemory:strategies||[],signals:signals||[],academicMemory:academicMemory||[]}}
    
    function legalAge(ctx){const n=Number(ctx?.base?.edad);return Number.isFinite(n)&&n>0?Math.round(n):null}
    function legalRelationshipValid(minor,relationship){return minor?["parent","mother","legal_guardian"].includes(String(relationship||"")):String(relationship||"")==="adult_user"}
    function legalEmailVerified(user){return Boolean(user?.email&& (user?.email_confirmed_at||user?.confirmed_at))}
    async function getActiveLegalAcceptance(env,uid){try{const rows=await supabase(env,`eterna_legal_acceptances?user_id=eq.${encodeURIComponent(uid)}&legal_version=eq.${encodeURIComponent(LEGAL_VERSION)}&withdrawn_at=is.null&select=*&order=accepted_at.desc&limit=1`);return rows?.[0]||null}catch(e){console.error("ETERNA LEGAL READ",String(e?.message||e));return null}}
    function legalRowAccepted(row,{minor,emailVerified}){if(!row||!emailVerified)return false;if(row.terms_accepted!==true||row.privacy_accepted!==true||row.ai_notice_accepted!==true)return false;if(!legalRelationshipValid(minor,row.relationship))return false;if(minor&&row.parental_authorization!==true)return false;return true}
    function legalStateFromAcceptance(auth,ctx,row){const age=legalAge(ctx),minor=age==null?true:age<18,emailVerified=legalEmailVerified(auth.user),accepted=legalRowAccepted(row,{minor,emailVerified});return{required:true,accepted,legal_version:LEGAL_VERSION,documents:LEGAL_DOCUMENTS,age,minor,email_verified:emailVerified,relationship:row?.relationship||null,accepted_at:row?.accepted_at||null,parental_authorization:Boolean(row?.parental_authorization),withdrawn:false}}
    async function getLegalState(env,auth,ctx=null){ctx=ctx||await getStudentContext(env,auth.user.id);const row=await getActiveLegalAcceptance(env,auth.user.id);return legalStateFromAcceptance(auth,ctx,row)}
    function legalRequiredResponse(state){return json({error:"ETERNA_LEGAL_ACCEPTANCE_REQUIRED",legal_version:state.legal_version,minor:state.minor,age:state.age,email_verified:state.email_verified,action:"OPEN_FAMILY_ZONE"},403)}
    async function requireLegalState(env,auth,ctx=null){const state=await getLegalState(env,auth,ctx);return state.accepted?{ok:true,state}:{ok:false,state,response:legalRequiredResponse(state)}}
    async function recentPurchaseAck(env,uid,plan){try{const rows=await supabase(env,`eterna_purchase_acknowledgements?user_id=eq.${encodeURIComponent(uid)}&plan=eq.${encodeURIComponent(plan)}&select=*&order=acknowledged_at.desc&limit=1`),row=rows?.[0];if(!row)return null;const age=Date.now()-new Date(row.acknowledged_at).getTime();return age>=0&&age<=30*60*1000?row:null}catch(e){return null}}
    async function handleLegalConsent(request,env,auth){
      const ctx=await getStudentContext(env,auth.user.id),state=await getLegalState(env,auth,ctx);
      if(request.method==="GET")return json(state);
      const body=await request.json().catch(()=>({})),action=String(body.action||"accept");
      if(action==="purchase_ack"){
        if(!state.accepted)return legalRequiredResponse(state);
        const plan=body.plan==="annual"?"annual":"monthly";
        if(body.recurring_ack!==true||body.withdrawal_info_ack!==true||body.immediate_service_requested!==true)return json({error:"PURCHASE_ACK_INCOMPLETE"},400);
        const priceText=plan==="annual"?"79,99 € / año":"7,99 € / mes";
        await supabase(env,"eterna_purchase_acknowledgements",{method:"POST",body:{user_id:auth.user.id,legal_version:LEGAL_VERSION,plan,price_text:priceText,recurring_ack:true,withdrawal_info_ack:true,immediate_service_requested:true,acknowledged_at:new Date().toISOString()}});
        return json({ok:true,plan,price_text:priceText,acknowledged_at:new Date().toISOString()})
      }
      if(action==="withdraw"){
        const row=await getActiveLegalAcceptance(env,auth.user.id);
        if(row)await supabase(env,`eterna_legal_acceptances?id=eq.${encodeURIComponent(row.id)}`,{method:"PATCH",body:{withdrawn_at:new Date().toISOString()}});
        return json({...await getLegalState(env,auth,ctx),accepted:false,withdrawn:true})
      }
      if(!state.email_verified)return json({error:"ADULT_EMAIL_VERIFICATION_REQUIRED",legal_version:LEGAL_VERSION},409);
      const relationship=String(body.relationship||""),minor=state.minor;
      if(!legalRelationshipValid(minor,relationship))return json({error:"LEGAL_RELATIONSHIP_REQUIRED",minor},400);
      if(body.terms_accepted!==true||body.privacy_accepted!==true||body.ai_notice_accepted!==true)return json({error:"LEGAL_ACCEPTANCE_INCOMPLETE"},400);
      if(minor&&body.parental_authorization!==true)return json({error:"PARENTAL_AUTHORIZATION_REQUIRED"},400);
      const existing=await getActiveLegalAcceptance(env,auth.user.id);
      if(existing&&legalRowAccepted(existing,{minor,emailVerified:true}))return json(await getLegalState(env,auth,ctx));
      if(existing)await supabase(env,`eterna_legal_acceptances?id=eq.${encodeURIComponent(existing.id)}`,{method:"PATCH",body:{withdrawn_at:new Date().toISOString()}});
      const row={user_id:auth.user.id,legal_version:LEGAL_VERSION,user_age:state.age,relationship,adult_email:String(auth.user.email||"").slice(0,320),email_verified:true,terms_accepted:true,privacy_accepted:true,ai_notice_accepted:true,parental_authorization:minor?true:false,immediate_service_ack:false,evidence_method:"authenticated_account+confirmed_email+explicit_declaration",document_versions:LEGAL_DOCUMENTS,accepted_at:new Date().toISOString(),withdrawn_at:null};
      await supabase(env,"eterna_legal_acceptances",{method:"POST",body:row});
      return json(await getLegalState(env,auth,ctx))
