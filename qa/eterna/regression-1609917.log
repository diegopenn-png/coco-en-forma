    function scopeV3Guard(text,decision,pedState,history){
      const d={...(decision||{})};d.subject=normalizeNullableModelText(d.subject);d.concept=normalizeNullableModelText(d.concept);d.domain=normalizeNullableModelText(d.domain);if(Array.isArray(d.ambiguity_options))d.ambiguity_options=d.ambiguity_options.slice(0,2);if(!/\([^)]+\)\s*$/.test(String(d.concept||"")))d.resolved_meaning=null;
