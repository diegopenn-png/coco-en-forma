    async function getReplay(uid,kind,id){if(!id||typeof caches==="undefined"||!caches.default)return null;const response=await caches.default.match(replayKey(uid,kind,id));if(!response)return null;const headers=new Headers(response.headers);headers.set("X-Eterna-Replayed","true");return new Response(response.body,{status:response.status,statusText:response.statusText,headers})}
