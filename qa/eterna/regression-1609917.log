    function cors(env,request){const origin=request.headers.get("Origin")||"";const allowed=String(env.ALLOWED_ORIGINS||"https://www.cocoenforma.com,https://cocoenforma.com").split(",").map(x=>x.trim()).filter(Boolean);const ok=allowed.includes("*")||allowed.includes(origin)||origin==="";return ok?{"Access-Control-Allow-Origin":origin||allowed[0]||"https://www.cocoenforma.com","Vary":"Origin","Access-Control-Allow-Headers":"Authorization, Content-Type, Cache-Control, Stripe-Signature","Access-Control-Allow-Methods":"GET,POST,OPTIONS","Access-Control-Expose-Headers":"X-Eterna-Job-Id, X-Eterna-Response-Id, X-Eterna-Job-Status, X-Eterna-Latency-Ms, X-Eterna-Job-Ms, X-Eterna-Poll-After-Ms, Server-Timing"}:null}
