    const RELATIONAL_STAGES=["opening","exploring","planning","checking_in"];
    const RELATIONAL_THREAD_SCHEMA={type:["object","null"],additionalProperties:false,properties:{kind:{type:"string",enum:RELATIONAL_KINDS},stage:{type:"string",enum:RELATIONAL_STAGES},turn_count:{type:"integer",minimum:1,maximum:12}},required:["kind","stage","turn_count"]};
    function schoolPeerReply(text){const s=stripTurnPunctuation(text),physical=/\b(?:me\s+empuja|me\s+golpea|me\s+quita\s+(?:mis\s+)?cosas|me\s+rompe\s+(?:mis\s+)?cosas)\b/.test(s);if(physical)return"Siento que te esté pasando esto. Que un compañero te empuje, te golpee o te quite cosas no está bien y no es culpa tuya. Aléjate y cuéntaselo ahora a un profesor y a un adulto de confianza. Si estás en peligro en este momento, busca a un adulto de inmediato.";return"Siento que estés pasando por eso. Que un compañero te moleste puede hacerte sentir mal, y no tienes que resolverlo a solas. Para ayudarte bien, cuéntame qué hace exactamente y desde cuándo. Díselo hoy a un profesor o a un adulto de confianza; si te amenaza o te hace daño, aléjate y busca ayuda enseguida."}
    function isRelationalSituation(situation){return Boolean(situation&&RELATIONAL_KINDS.includes(situation.kind))}
    function relationalContinuationSignal(text,pedState){const thread=sanitizeRelationalThread(pedState?.relational_thread),s=stripTurnPunctuation(text);if(!thread||!s)return null;if(/\b(?:volvamos|retomemos|retoma|retomar|vuelve|regresemos|regresa|sigamos\s+con|continuemos\s+con|cambiemos\s+de\s+tema|otra\s+pregunta\s+del\s+cole)\b/.test(s))return null;if(/^(?:quiero|necesito|vamos\s+a|podemos)\s+(?:estudiar|aprender|repasar|practicar)\b|^(?:ayudame|ayúdame)\s+con\b/.test(s))return null;if(clearNonAcademicIntent(text))return null;if(educationalIntentSignal(text)&&academicDomainSignal(text,{},null,[]))return null;return{kind:thread.kind,follow_up:true,stage:thread.stage}}
    function weatherLocation(text){const raw=String(text||"").trim(),m=raw.match(/\ben\s+([\p{L}][\p{L}\s.'-]{1,58})[?!.]*$/iu);return m?cleanChildText(m[1]).trim().slice(0,60):null}
    function academicWeatherExplanation(text){
      const s=stripTurnPunctuation(text);if(!s)return false;
      const phenomenon=/\b(?:llueve|llover|lluvia|nieva|nevar|nieve|granizo|tormenta|trueno|relampago|rayos?|viento|frio|calor|nubes?|arcoiris)\b/.test(s);
      if(!phenomenon)return false;
      return /^(?:por que|como|que causa|que provoca|a que se debe|de donde viene|explicame|cuentame|quiero saber)\b/.test(s)||/\b(?:como se forma|por que se forma|ciclo del agua|fenomeno atmosferico)\b/.test(s)
    }
    function classroomSituation(text,history=[],pedState=null){
      const s=stripTurnPunctuation(text);if(!s||teacherCoreSafetySignal(s))return null;
      if(pureCourtesy(text)){const thread=sanitizeRelationalThread(pedState?.relational_thread);if(thread&&/\b(?:gracias|adios|hasta\s+luego|nos\s+vemos|chao|chau)\b/.test(s))return{kind:thread.kind,follow_up:true,stage:thread.stage,closure_hint:true};return{kind:"courtesy"}}
      const previous=normalizeDetectionText(latestAssistantText(history));
      if(/\b(?:que|qué)\s+ciudad\b/.test(previous)&&/^[\p{L}][\p{L}\s.'-]{1,58}$/u.test(String(text||"").trim()))return{kind:"weather_query",location:cleanChildText(text).trim().slice(0,60)};
      if(/\b(?:que|qué)\s+(?:tiempo|clima)\s+hace\s+hoy\b|\b(?:tiempo|clima)\s+de\s+hoy\b|\bva\s+a\s+llover\s+hoy\b|\btemperatura\s+(?:hoy|actual)\b/.test(s))return{kind:"weather_query",location:weatherLocation(text)};
      if(academicWeatherExplanation(text))return null;
      if(/\b(?:hace\s+(?:mucho\s+)?(?:frio|frío|calor)|esta\s+(?:lloviendo|nevando)|está\s+(?:lloviendo|nevando)|llueve|nieva|hace\s+(?:mucho\s+)?viento)\b/.test(s))return{kind:"weather_observation"};
      if(/^(?:cual\s+es\s+tu\s+mision|que\s+mision\s+tienes|para\s+que\s+(?:sirves|existes|fuiste\s+creada)|por\s+que\s+existes|que\s+puedes\s+hacer|como\s+me\s+(?:ayudas|puedes\s+ayudar)|que\s+haces)$/.test(s))return{kind:"mission"};
      if(/^(?:quien\s+eres|que\s+eres|como\s+te\s+llamas|eres\s+eterna|(?:eres|tu\s+eres)\s+(?:una\s+)?(?:persona|humano|humana|robot|ia)|cuantos\s+anos\s+tienes)$/.test(s))return{kind:"identity"};
      const oneOffEmbarrassment=(/\b(?:me\s+equivoqu[eé]|me\s+sali[oó]\s+mal)\b.{0,100}\b(?:leyendo|en\s+voz\s+alta|en\s+clase)\b/.test(s)&&/\b(?:se\s+rieron|se\s+han\s+re[ií]do|verg[uü]enza|no\s+quiero\s+volver)\b/.test(s))||(/\bno\s+hay\s+peligro\b/.test(s)&&/\b(?:se\s+rieron|verg[uü]enza|hablar\s+con\s+(?:ella|el|él|mi\s+profesor))\b/.test(s));
      if(oneOffEmbarrassment)return{kind:"classroom_embarrassment"};
      if(/\b(?:copiar|copie|copi[eé]|deje\s+copiar|dejes\s+copiar)\b/.test(s)&&/\b(?:deberes|tarea|ejercicio|examen)\b/.test(s)&&/\b(?:amigo|amiga|amistad|presiona|amenaza|si\s+no)\b/.test(s))return{kind:"academic_integrity"};
      const schoolPeer=/\b(?:companero|companera|companeros|companeras|alumno|alumna|nino|nina|chico|chica)\b/.test(s)||/\balguien\s+de\s+(?:mi\s+)?(?:clase|cole|colegio|instituto)\b/.test(s),peerProblem=/\b(?:me\s+molesta|me\s+fastidia|no\s+me\s+deja\s+en\s+paz|se\s+burla\s+de\s+mi|se\s+rie\s+de\s+mi|me\s+aparta|me\s+excluye|no\s+me\s+deja\s+jugar|me\s+quita\s+(?:mis\s+)?cosas|me\s+rompe\s+(?:mis\s+)?cosas|me\s+insulta|me\s+llama\s+cosas|me\s+trata\s+mal|me\s+empuja|no\s+me\s+habla|hemos\s+discutido)\b/.test(s);
      if(schoolPeer&&peerProblem)return{kind:"school_peer_problem"};
      if(/\b(?:estoy|me\s+siento)\s+(?:nervios[oa]|preocupad[oa]|agobiad[oa])\b/.test(s)&&/\b(?:cole|clase|examen|tarea|deberes|estudiar)\b/.test(s))return{kind:"school_emotion"};
      if(/\b(?:estoy|me\s+siento)\s+(?:cansad[oa]|distraid[oa]|bloquead[oa])\b/.test(s))return{kind:"learning_readiness"};
      if(/\b(?:me\s+gustan?|no\s+me\s+gustan?|me\s+encantan?|me\s+aburre[n]?|es\s+divertid[oa]|es\s+aburrid[oa])\b.{0,55}\b(?:cole|clase|asignatura|mates|matematicas|matemáticas|lengua|ciencias|historia|tema)\b|\b(?:hoy|esta\s+mañana)\b.{0,35}\b(?:cole|clase)\b.{0,35}\b(?:bien|mal|genial|fatal)\b/.test(s))return{kind:"classroom_reflection"};
      if(/^(?:tengo\s+(?:hambre|sed)|puedo\s+ir\s+al\s+ba[nñ]o)$/.test(s))return{kind:"basic_need"};
      if(/\b(?:me\s+duele\s+(?:la\s+)?(?:cabeza|barriga|estomago|estómago)|me\s+encuentro\s+mal|estoy\s+maread[oa])\b/.test(s))return{kind:"physical_discomfort"};
      const explicitlyAcademic=educationalIntentSignal(text)&&academicDomainSignal(text,{},pedState,history),humanConcern=/\b(?:estoy|me\s+siento|me\s+da|tengo|no\s+puedo|me\s+cuesta|me\s+preocupa|me\s+asusta|me\s+enfada|me\s+pone)\b.{0,70}\b(?:triste|solo|sola|enfadad[oa]|preocupad[oa]|asustad[oa]|mal|sin\s+ganas|nervios[oa]|verg[uü]enza|miedo|ansiedad|agobiad[oa]|bloquead[oa])\b/.test(s),personalEvent=/\b(?:mis\s+padres\s+se\s+(?:separan|estan\s+separando)|ha\s+muerto\s+(?:mi|un\s+familiar)|falleci[oó]\s+(?:mi|un\s+familiar)|he\s+discutido\s+con|hemos\s+discutido|no\s+tengo\s+amigos|me\s+siento\s+sol[oa]|no\s+quiero\s+ir\s+al\s+cole)\b/.test(s),relationshipConcern=/\b(?:mi\s+amig[oa]\b.{0,35}\bno\s+me\s+habla|nadie\s+quiere\s+(?:jugar|estar)\s+conmigo|me\s+dejan\s+de\s+lado|se\s+burlan\s+de\s+mi)\b/.test(s),learningEffect=/\b(?:no\s+(?:me\s+)?concentro|no\s+consigo\s+concentrarme|no\s+puedo\s+estudiar|no\s+tengo\s+ganas\s+de\s+estudiar|me\s+cuesta\s+aprender|me\s+afecta\s+en\s+clase)\b/.test(s);
      if(!explicitlyAcademic&&(humanConcern||personalEvent||relationshipConcern||learningEffect))return{kind:"student_wellbeing"};
      return relationalContinuationSignal(text,pedState)
    }
    function preservedInterruptionState(pedState,mode){return{...pedState,current_mode:mode,student_answer_assessment:"not_applicable",turn_index:Math.min(500,Number(pedState?.turn_index||0)+1)}}
    function preservedSituationalState(pedState,mode,situation){const state=sanitizePedagogicalState(pedState,mode),existing=sanitizeRelationalThread(state.relational_thread),kind=RELATIONAL_KINDS.includes(situation?.kind)?situation.kind:(existing?.kind||"student_wellbeing");if(!existing&&!state.suspended_topic)suspendCurrentTopic(state);state.relational_thread={kind,stage:existing?.stage||"opening",turn_count:Math.min(12,Number(existing?.turn_count||0)+1)};return preservedInterruptionState(state,mode)}
    function safetyInterruptionPayload(category,pedState,mode,modeState,text=""){const operational=category==="harmful_request";return{reply:safetyReplyFor(category,text),verification_status:"blocked_safety",ui_status:operational?{label:"Puedo ayudarte de una forma segura",tone:"safety",kind:"safety_boundary"}:{label:"Habla ahora con un adulto de confianza",tone:"safety",kind:"safety"},subject:null,concept:null,help_level:null,check_question:null,practice_suggestion:null,student_answer_assessment:"not_applicable",strategy_used:null,mode_label:MODE_PROFILES[mode].label,mode_state:modeState,pedagogical_state:preservedInterruptionState(pedState,mode),auto_speak:false,safety_interrupt:true,safety_category:category,resume_available:Boolean(pedState?.pending_question)}}
    function situationalReply(situation,text,name){
      if(situation.kind==="courtesy")return courtesyReply(text,name);
      if(situation.kind==="weather_query"&&!situation.location)return"Puedo comprobar el tiempo de hoy, pero necesito un lugar. ¿De qué ciudad quieres consultarlo? No hace falta que sea donde estás.";
      if(situation.kind==="weather_observation")return"Vaya, entonces conviene estar bien abrigado y cómodo. Cuando estés listo, seguimos con calma.";
      if(situation.kind==="identity"||situation.kind==="mission")return eternaIdentityReply();
      if(situation.kind==="classroom_embarrassment")return"Entiendo que te haya dado vergüenza; equivocarse al leer le puede pasar a cualquiera y una risa no dice nada malo sobre ti. Mañana puedes empezar con algo pequeño: respirar despacio y decirle en privado a tu profesora «me dio vergüenza lo de ayer, ¿me ayudas?». Si las burlas se repiten, cuéntaselo también a tu familia o tutor para que puedan ayudarte.";
      if(situation.kind==="academic_integrity")return"No le dejes copiar: copiar no le ayuda a aprender y puede meteros en un problema a los dos. Puedes decirle «no te paso las respuestas, pero te ayudo a entender el ejercicio». Una amistad sana no depende de que hagas algo que sabes que no está bien; si sigue presionándote, habla con el profesor con calma.";
      if(situation.kind==="school_peer_problem")return schoolPeerReply(text);
      if(situation.kind==="school_emotion")return"Es normal sentirse así antes de una tarea o un examen. Haz una respiración lenta, empezamos por una sola cosa y avanzamos paso a paso.";
      if(situation.kind==="learning_readiness")return"Gracias por decírmelo. Podemos hacer una pausa corta, beber agua y volver con una sola pregunta sencilla. Aprender cansado cuesta más.";
      if(situation.kind==="classroom_reflection")return"Te escucho. Saber qué te gusta o qué te cuesta me ayuda a explicártelo mejor. Podemos trabajar ese tema de una forma distinta y paso a paso.";
      if(situation.kind==="student_wellbeing")return"Te escucho. Lo que cuentas puede pesar mucho y también hacer que concentrarte o estudiar resulte más difícil. No hace falta resolverlo todo de una vez: cuéntame qué parte te está afectando más ahora y pensamos juntos un primer paso seguro.";
      if(situation.kind==="basic_need")return"Atiéndelo primero: díselo al adulto o profesor que esté contigo. Después seguimos; no hace falta aprender con prisa ni incómodo.";
      if(situation.kind==="physical_discomfort")return"Díselo ahora a un adulto que esté contigo. Descansa y no sigas forzándote; si el dolor es fuerte, empeora o te preocupa, ese adulto debe pedir ayuda sanitaria.";
      return"Te escucho. Cuando quieras, seguimos con el cole."
    }
    const RELATIONAL_REPLY_SCHEMA={type:"object",additionalProperties:false,properties:{reply:{type:"string"},thread_stage:{type:"string",enum:RELATIONAL_STAGES},continue_thread:{type:"boolean"},adult_support:{type:"string",enum:["none","helpful","important","urgent"]},safety_category:{type:"string",enum:["none","bullying","personal_danger","unsafe_contact","self_harm"]}},required:["reply","thread_stage","continue_thread","adult_support","safety_category"]};
    function relationalFallbackReply(situation,text){if(situation?.closure_hint)return"De nada. Has hecho bien en hablarlo; si vuelve a preocuparte o la situación cambia, cuéntaselo también a un adulto de confianza.";if(situation?.kind==="school_peer_problem"&&situation?.follow_up)return"Vamos a hacerlo concreto. No respondas insultando ni te quedes a solas con el problema: aléjate si vuelve a ocurrir, anota qué pasó y cuéntaselo hoy a un profesor con una frase sencilla, por ejemplo: «Necesito ayuda porque un compañero me está molestando». ¿Qué hace exactamente cuando te molesta?";if(situation?.follow_up)return"Te sigo. Vamos a centrarnos en lo que acaba de pasar y pensar en un paso pequeño y seguro que puedas dar hoy. ¿Qué parte de la situación te preocupa más?";return situationalReply(situation,text,"")}
    async function relationalTutor(env,{text,history,ctx,situation,pedState}){const policy=ageTeachingProfile(ctx),thread=sanitizeRelationalThread(pedState?.relational_thread),studentName=displayStudentName(ctx?.base?.apodo||ctx?.profile?.apodo||""),recentInterventions=recentInterventionTags(history);const prompt=`Devuelve JSON. Eres Eterna en una conversación de acompañamiento docente con un menor.
    ${teacherCoreInstruction(policy)}
    OBJETIVO: escucha y acompaña como una gran profesora, sin convertirte en terapeuta, amiga exclusiva ni sustituta de la familia o del centro.
    INTERVENCIONES YA UTILIZADAS RECIENTEMENTE=${JSON.stringify(recentInterventions)}. No repitas una intervención ya utilizada salvo que aparezca información nueva que la haga necesaria; el siguiente turno debe avanzar de escuchar→comprender→aclarar→ayudar→comprobar→cerrar.
    REGLAS:
    1) Responde primero al MENSAJE ACTUAL. El historial solo aclara referencias; no arrastres el tema académico suspendido ni lo menciones como salida automática.
    2) Si es un seguimiento, avanza: responde a la nueva información o a lo que pregunta. No repitas el mismo aviso, la misma validación ni «lo siento que estés pasando por eso».
    3) Interés real significa reflejar un detalle concreto, ofrecer un paso útil y formular como máximo UNA pregunta natural. Si pregunta qué hacer o cómo actuar, dale antes 1–3 pasos y, cuando ayude, una frase exacta que pueda decir.
    4) Mantén el hilo hasta que el alumno lo cierre o cambie claramente de tema. No fuerces el regreso a los deberes.
    5) Apoyo adulto proporcional: helpful para una ayuda conveniente, important para problemas repetidos o que desbordan, urgent solo ante peligro inmediato. No menciones 112 salvo peligro inmediato.
    6) No diagnostiques, no prometas secreto, no fomentes dependencia y no pidas datos personales. Texto claro, natural y sin Markdown.
    7) Si detectas acoso repetido, peligro, captación o autolesión que no fue reconocido antes, marca safety_category; no desarrolles instrucciones de riesgo.
    Edad/curso=${JSON.stringify(policy)}. Nombre opcional=${JSON.stringify(studentName||null)}. Hilo=${JSON.stringify(thread||{kind:situation?.kind||"student_wellbeing",stage:"opening",turn_count:0})}. Situación detectada=${JSON.stringify(situation||null)}. Historial reciente=${JSON.stringify((history||[]).slice(-6))}. MENSAJE ACTUAL=${JSON.stringify(String(text||"").slice(0,3000))}.`;const args={model:env.TUTOR_MODEL||"gpt-5.6-sol",reasoning_effort:env.TUTOR_REASONING_EFFORT||"high",instructions:"Acompañamiento docente humano, prudente y natural. Prioriza el mensaje actual, conserva continuidad y aplica seguridad proporcional.",input:[{role:"user",content:[{type:"input_text",text:prompt}]}],name:"eterna_relational_tutor_v1",schema:RELATIONAL_REPLY_SCHEMA,max_output_tokens:900};return structured(env,args)}
    function relationalPayload(result,{situation,text,pedState,mode,modeState}){const data=result?.data||{},kind=RELATIONAL_KINDS.includes(situation?.kind)?situation.kind:(sanitizeRelationalThread(pedState?.relational_thread)?.kind||"student_wellbeing"),state=preservedSituationalState(pedState,mode,{kind}),reply=repairIncompleteReply(data.reply)||relationalFallbackReply(situation,text);state.last_student_intent="relational_followup";if(data.continue_thread===false)state.relational_thread=null;else state.relational_thread={kind,stage:RELATIONAL_STAGES.includes(data.thread_stage)?data.thread_stage:"exploring",turn_count:Math.min(12,Number(state.relational_thread?.turn_count||1))};return{reply,verification_status:"verified",subject:null,concept:null,help_level:null,check_question:null,practice_suggestion:null,student_answer_assessment:"not_applicable",strategy_used:null,mode_label:MODE_PROFILES[mode].label,mode_state:modeState,pedagogical_state:state,auto_speak:false,situational:true,situational_kind:kind,relational:true,relational_stage:state.relational_thread?.stage||"closed",resume_available:Boolean(state.suspended_topic||state.pending_question)}}
    async function currentWeatherLookup(env,location){
      if(!location||!String(env.OPENAI_API_KEY||"").trim())return null;
      try{const payload={model:env.WEB_SEARCH_MODEL||"gpt-5.6-terra",reasoning:{effort:reasoningEffort(env.WEB_SEARCH_REASONING_EFFORT,"low")},tools:[{type:"web_search",filters:{allowed_domains:["aemet.es"]},search_context_size:"low"}],input:[{role:"user",content:[{type:"input_text",text:`Consulta en AEMET el tiempo actual o la previsión de hoy para ${location}, España. Responde en español en 2 o 3 frases, de forma natural para un alumno. Indica temperatura o intervalo, precipitación y viento solo si la fuente los muestra. Si no puedes identificar el municipio o no hay datos actuales, dilo claramente y pide provincia o municipio; no inventes.`}]}],max_output_tokens:520,store:false},r=await openai(env,"/responses",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)}),data=await r.json(),reply=repairIncompleteReply(outputText(data));return reply?{reply,sources:extractWebSources(data),usage:data.usage||{}}:null}catch(e){console.error("ETERNA CLASSROOM WEATHER",String(e?.message||e));return null}
    }
    function detAmb(t,p,h){const x=normalizeDetectionText(t),c=normalizeDetectionText([p?.active_concept,p?.active_topic,p?.pending_question,latestAssistantText(h),...(h||[]).slice(-4).map(z=>z&&z.text)].filter(Boolean).join(" "));if(!/\bkiwi\b/.test(x+" "+c))return null;if(/\b(ave|pajaro|animal)\b/.test(x))return{resolved_meaning:"ave",concept:"kiwi (ave)"};if(/\b(fruta|fruto)\b/.test(x))return{resolved_meaning:"fruta",concept:"kiwi (fruta)"};if(/kiwi\s*\(ave\)|kiwi como ave|kiwi,? el ave/.test(c))return{resolved_meaning:"ave",concept:"kiwi (ave)"};if(/kiwi\s*\(fruta\)|kiwi como fruta|kiwi,? la fruta/.test(c))return{resolved_meaning:"fruta",concept:"kiwi (fruta)"};if(/\bkiwi\b/.test(x))return{ambiguity:true,ambiguity_term:"kiwi",ambiguity_options:["el kiwi, el ave","el kiwi, la fruta"],concept:"kiwi"};return null}
