    function withoutExplicitPromptCache(input){return Array.isArray(input)?input.map(message=>({...message,content:Array.isArray(message?.content)?message.content.map(part=>{if(!part||typeof part!=="object"||!("prompt_cache_breakpoint" in part))return part;const clean={...part};delete clean.prompt_cache_breakpoint;return clean}):message?.content})):input}
