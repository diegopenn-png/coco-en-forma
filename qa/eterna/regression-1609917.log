    function normalizeVerifyDecision(data,{stableSchool=false,factAnchor=null,mathCheck=null,curriculum=[],externalEvidence=null}={}){
      const d=data&&typeof data==="object"?data:{},verdict=VERIFY_VERDICTS.includes(d.verdict)?d.verdict:(d.verified?"verified":d.requires_clarification?"missing_information":"verifier_uncertain");
      if(verdict==="verified")return{verdict,status:"verified",blocking:false,use_correction:false};
      if(verdict==="pedagogy_improvement")return{verdict,status:"verified",blocking:false,use_correction:Boolean(d.corrected_reply)};
      if(verdict==="verifier_uncertain"){
        const grounded=Boolean(stableSchool||factAnchor||mathCheck||(curriculum&&curriculum.length)||externalEvidence);
        return grounded?{verdict,status:"verified",blocking:false,use_correction:false}:{verdict,status:"needs_clarification",blocking:true,use_correction:Boolean(d.corrected_reply)}
      }
      if(verdict==="missing_information")return{verdict,status:"needs_clarification",blocking:true,use_correction:Boolean(d.corrected_reply)};
      return{verdict,status:"verification_conflict",blocking:true,use_correction:Boolean(d.corrected_reply)}
    }
    
    
