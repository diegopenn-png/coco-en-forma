    function clearSafetySignal(text){return teacherCoreSafetySignal(text)}
    function clearTopicSwitchSignal(text){return unsafeOperationalIntent(text)}
    function normalizeNullableModelText(value){const s=String(value==null?"":value).trim();return !s||/^(?:null|undefined|none|n\/?a|na)$/i.test(s)?null:s}
    function clearNonAcademicIntent(text){
