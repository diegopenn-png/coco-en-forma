    function parseContractV3Input(body,{mode,modeState,pedState}){const version=Number(body?.client_state_contract||0),enabled=version>=CONTRACT_V3,requestId=cleanOpaqueId(body?.request_id||body?.client_turn_id),clientTurnId=cleanOpaqueId(body?.client_turn_id||body?.request_id),answeredQuestionId=cleanOpaqueId(body?.answered_question_id),studentAction=canonicalStudentAction(body?.student_action||body?.event||body?.student_intent),activityState=enabled?sanitizeActivityStateV3(body?.activity_state,{mode,modeState,pedState}):null,contract=contractV3();let validation={ok:true,errors:[]};if(enabled&&contract&&typeof contract.validateActivityRequest==="function")validation=contract.validateActivityRequest(activityState,{expected_mode:mode});return{enabled,version,requestId,clientTurnId,answeredQuestionId,studentAction,activityState,validation}}
    function staleQuestionProblem(meta,pedState){if(!meta.enabled||meta.studentAction!=="answer")return null;const contract=contractV3(),expected=cleanOpaqueId(pedState?.pending_question_id||meta.activityState?.question_id);if(!expected)return{error:"ETERNA_STALE_QUESTION",reason:"NO_PENDING_QUESTION"};if(!meta.answeredQuestionId)return{error:"ETERNA_QUESTION_ID_REQUIRED",reason:"ANSWERED_QUESTION_ID_REQUIRED"};if(contract&&typeof contract.validateActivityRequest==="function"){const checked=contract.validateActivityRequest({...meta.activityState,question_id:expected,phase:"WAIT"},{expected_mode:meta.activityState.mode,answered_question_id:meta.answeredQuestionId,require_answer:true});if(!checked.ok)return{error:checked.errors?.some(x=>x.code==="STALE_QUESTION")?"ETERNA_STALE_QUESTION":"ETERNA_QUESTION_ID_REQUIRED",reason:checked.errors?.[0]?.code||"INVALID_ANSWER"}}else if(meta.answeredQuestionId!==expected)return{error:"ETERNA_STALE_QUESTION",reason:"QUESTION_ID_MISMATCH"};return null}
    function activityStateForResponse(input,payload,mode,actionId){if(!input)return null;const contract=contractV3(),ms=sanitizeModeState(payload?.mode_state||{}),ps=sanitizePedagogicalState(payload?.pedagogical_state||{},mode),questionId=cleanOpaqueId(ps.pending_question_id),phase=questionId?"WAIT":ps.conversation_stage==="complete"?"CLOSE":payload?.student_answer_assessment&&payload.student_answer_assessment!=="not_applicable"?"FEEDBACK":"ASK",raw={...input,mode,phase,question_id:phase==="CLOSE"?null:questionId,question_number:Math.max(1,ms.question_number||input.question_number||1),correct_count:ms.correct_count,partial_count:ms.partial_count,incorrect_count:ms.incorrect_count,difficulty:ms.difficulty,last_action_id:cleanOpaqueId(actionId)||input.last_action_id};if(mode!=="practice")raw.practice_target=null;if(contract&&typeof contract.sanitizeActivityState==="function")return contract.sanitizeActivityState(raw,{mode,session_id:input.session_id});return fallbackActivityStateV3(raw,{mode,modeState:ms,pedState:ps})}
    function addContractEnvelope(response,meta,mode){if(!meta?.enabled)return response;return (async()=>{const type=response.headers.get("Content-Type")||"";if(!/application\/json/i.test(type))return response;let payload;try{payload=await response.clone().json()}catch(_e){return response}if(!payload||typeof payload!=="object")return response;const activity=activityStateForResponse(payload.activity_state||meta.activityState,payload,mode,meta.requestId||meta.clientTurnId),body={...payload,client_state_contract:CONTRACT_V3,request_id:meta.requestId,client_turn_id:meta.clientTurnId,activity_state:activity};const headers=new Headers(response.headers);headers.set("X-Eterna-Request-Id",meta.requestId||"");headers.set("X-Eterna-Client-Turn-Id",meta.clientTurnId||"");return new Response(JSON.stringify(body),{status:response.status,statusText:response.statusText,headers})})()}
